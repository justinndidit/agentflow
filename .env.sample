# =====================================================================================
# DOCKER
# Consumed by docker-compose.dev.yml to provision the Postgres container.
# =====================================================================================
DB_NAME=agentflow_db
DB_USER=postgres
DB_PASSWORD=password

# =====================================================================================
# APPLICATION
#
# Read by the agentflow process. Names are AGENTFLOW__<SECTION>__<KEY>: the
# double underscore separates the section from the key, because key names
# contain single underscores of their own.
#
# Every value below is also the built-in default, so this file is a starting
# point rather than a requirement. Real environment variables override anything
# set here.
# =====================================================================================

# The database scripts/init_db.sql creates. Note this is NOT the container's
# DB_NAME above — that one has none of the extensions the schema needs.
AGENTFLOW__DATABASE__NAME=agentflow
AGENTFLOW__DATABASE__HOST=localhost
AGENTFLOW__DATABASE__PORT=5433
AGENTFLOW__DATABASE__USER=postgres
AGENTFLOW__DATABASE__PASSWORD=password

# Passed through to the connection string verbatim, so it takes a libpq mode
# (disable, allow, prefer, require, verify-ca, verify-full) and not a boolean.
AGENTFLOW__DATABASE__SSL_MODE=disable

AGENTFLOW__DATABASE__MAX_OPEN_CONNS=10
AGENTFLOW__DATABASE__MAX_IDLE_CONNS=2
# Seconds.
AGENTFLOW__DATABASE__CONN_MAX_LIFETIME=3600
AGENTFLOW__DATABASE__CONN_MAX_IDLE_TIME=300

# A golang-migrate source URL, not a plain path. Relative to the working
# directory, so it resolves from a fresh clone without editing.
AGENTFLOW__MIGRATIONS__PATH=file://migrations

# -------------------------------------------------------------------------------------
# ENGINE
#
# Node properties, not workflow properties: capacity follows this host's CPU and
# memory rather than anything a manifest asked for.
# -------------------------------------------------------------------------------------

# Tasks this node runs concurrently. The dispatcher never claims past it.
AGENTFLOW__ENGINE__CAPACITY=4

# Seconds between heartbeats. Liveness is per engine, not per task, so this is
# one write per node per interval however much work is in flight.
AGENTFLOW__ENGINE__HEARTBEAT_INTERVAL=5

# Seconds a claim is honoured for. Must exceed the heartbeat interval by a
# comfortable margin — the reaper treats an engine whose heartbeat is older than
# this as dead, and a TTL close to the interval reclaims work from nodes that are
# merely busy.
AGENTFLOW__ENGINE__LEASE_TTL=60
