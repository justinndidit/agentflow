# =====================================================================================
# DOCKER
# Consumed by docker-compose.dev.yml to provision the Postgres container.
# =====================================================================================
DB_NAME=agentflow_db
DB_USER=postgres
DB_PASSWORD=password

# =====================================================================================
# APPLICATION
#
# Read by the agentflow process. Names are AGENTFLOW__<SECTION>__<KEY>: the
# double underscore separates the section from the key, because key names
# contain single underscores of their own.
#
# Every value below is also the built-in default, so this file is a starting
# point rather than a requirement. Real environment variables override anything
# set here.
# =====================================================================================

# The database scripts/init_db.sql creates. Note this is NOT the container's
# DB_NAME above — that one has none of the extensions the schema needs.
AGENTFLOW__DATABASE__NAME=agentflow
AGENTFLOW__DATABASE__HOST=localhost
AGENTFLOW__DATABASE__PORT=5433
AGENTFLOW__DATABASE__USER=postgres
AGENTFLOW__DATABASE__PASSWORD=password

# Passed through to the connection string verbatim, so it takes a libpq mode
# (disable, allow, prefer, require, verify-ca, verify-full) and not a boolean.
AGENTFLOW__DATABASE__SSL_MODE=disable

AGENTFLOW__DATABASE__MAX_OPEN_CONNS=10
AGENTFLOW__DATABASE__MAX_IDLE_CONNS=2
# Seconds.
AGENTFLOW__DATABASE__CONN_MAX_LIFETIME=3600
AGENTFLOW__DATABASE__CONN_MAX_IDLE_TIME=300

# A golang-migrate source URL, not a plain path. Relative to the working
# directory, so it resolves from a fresh clone without editing.
AGENTFLOW__MIGRATIONS__PATH=file://migrations

# -------------------------------------------------------------------------------------
# ENGINE
#
# Node properties, not workflow properties: capacity follows this host's CPU and
# memory rather than anything a manifest asked for.
# -------------------------------------------------------------------------------------

# Tasks this node runs concurrently. The dispatcher never claims past it.
AGENTFLOW__ENGINE__CAPACITY=4

# Seconds between heartbeats. Liveness is per engine, not per task, so this is
# one write per node per interval however much work is in flight.
AGENTFLOW__ENGINE__HEARTBEAT_INTERVAL=5

# Seconds a claim is honoured for. Must exceed the heartbeat interval by a
# comfortable margin — the reaper treats an engine whose heartbeat is older than
# this as dead, and a TTL close to the interval reclaims work from nodes that are
# merely busy.
AGENTFLOW__ENGINE__LEASE_TTL=60

# Seconds between claim polls when no notification arrives first. Notifications
# are the fast path; this is the floor that covers a missed one.
AGENTFLOW__ENGINE__POLL_INTERVAL=2

# Seconds between sweeps for work abandoned by lost nodes. Coarse on purpose:
# reaping early duplicates work that is still running.
AGENTFLOW__ENGINE__REAP_INTERVAL=15

# How tasks are executed. "docker" runs each agent's container image; "echo"
# runs no container and returns the input as the output.
#
# Echo is the default because the seeded development agents point at placeholder
# images that are not published anywhere — switching to docker without
# registering real images fails every task.
AGENTFLOW__ENGINE__RUNTIME=echo

# Per-container limits. A node runs several tasks at once, so these bound one
# task's share of the host rather than describing what a task may want.
AGENTFLOW__ENGINE__TASK_MEMORY_MB=512
AGENTFLOW__ENGINE__TASK_CPUS=1

# Docker network mode for a task container. "none" isolates it completely;
# agents that call a model provider need "bridge".
AGENTFLOW__ENGINE__TASK_NETWORK=bridge

# =====================================================================================
# BLOB STORAGE
#
# Where task output too large for Postgres goes. Any S3-compatible service
# works — MinIO locally, S3/R2/Ceph in production — because the engine talks the
# S3 API rather than to a particular product.
#
# Optional. With it disabled, workers get no AGENTFLOW_ARTIFACT_URI and are
# expected to return their output inline; anything over the inline limit fails
# the attempt.
# =====================================================================================
AGENTFLOW__BLOB__ENABLED=false
AGENTFLOW__BLOB__ENDPOINT=localhost:9000
AGENTFLOW__BLOB__ACCESS_KEY=minioadmin
AGENTFLOW__BLOB__SECRET_KEY=minioadmin
AGENTFLOW__BLOB__BUCKET=agentflow-artifacts
AGENTFLOW__BLOB__REGION=us-east-1

# Only false for a local MinIO on plain HTTP.
AGENTFLOW__BLOB__USE_SSL=false

# -------------------------------------------------------------------------------------
# DOCKER (blob)
# Consumed by docker-compose.dev.yml to provision MinIO.
# -------------------------------------------------------------------------------------
BLOB_ACCESS_KEY=minioadmin
BLOB_SECRET_KEY=minioadmin
BLOB_BUCKET=agentflow-artifacts
